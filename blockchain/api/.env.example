# ============================
# Listening Port
# ============================
PORT=3000

# ============================
# Blockchain Data
# ============================
GYMTOKEN_ADDRESS="your_token_address"
FORWARDER_ADDRESS="your_forwarder_address"
SEPOLIA_RPC_URL="sepolia_url"
RELAYER_PRIVATE_KEY=""

# Restricted login to public.membership_rewards in the existing backend DB.
# Compose sets this from devops/.env; for running outside Compose set it here.
# Example: postgresql://blockchain_rewards_app:<password>@db:5432/testing_db?schema=public
REWARDS_DATABASE_URL=
# Same random secret (at least 32 characters) as backend REWARD_INTERNAL_SECRET.
REWARD_INTERNAL_SECRET=
# GymToken owner wallet, funded for gas. Reserve this wallet for rewards.
# Use a different gas wallet for RELAYER_PRIVATE_KEY.
REWARD_OWNER_PRIVATE_KEY=
