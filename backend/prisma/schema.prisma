// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// * this enum had Gender of Member
enum Gender {
  MALE
  FEMALE
}

// * this enum had type of user
enum UserType {
  OWNER
  ADMIN
  USER
}

// * this enum had Account Status
enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING
  BANNED
}

// * this enum had Subscription Status
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// * this enum had Member Status
enum MemberStatus {
  ACTIVE
  FROZEN
  BANNED
}

// * this enum had Member Status
enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// * this enum had Payment Status
enum PaymentStatus {
  PAID
  UNPAID
  OVERDUE
}

// * this enum had Notification Type
enum NotificationType {
  PAYMENT_REMINDER
  MEMBERSHIP_EXPIRATION
  CUSTOM
}

// * Table of users
model User {
  id                String        @id @default(uuid())
  firstName         String
  lastName          String
  gender            Gender
  birthDate         DateTime
  userName          String        @unique
  email             String        @unique
  password          String
  phoneNumber       String        @unique
  companyName       String
  userType          UserType      @default(ADMIN)
  subscription      Subscription?
  profileImage      String        @default("default-image.jpg")
  isAccountVerified Boolean       @default(false)
  accountStatus     AccountStatus @default(INACTIVE)
  termsAccepted     Boolean

  members         Member[]
  memberships     Membership[]
  membershipPlans MembershipPlan[]
  payments        Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// * Table of Plan
model Plan {
  id String @id @default(uuid())

  planName String @unique // BASIC, PRO, ENTERPRISE

  maxMembers  Int // 100
  description String?
  durations   PlanDuration[]

  isActive Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

// * Table of Plan Duration
model PlanDuration {
  id String @id @default(uuid())

  durationDays Int
  price        Decimal @db.Decimal(10, 2)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("planDurations")
}

// * Table of Subscription
model Subscription {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  planDurationId String
  planDuration   PlanDuration @relation(fields: [planDurationId], references: [id])

  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime
  // autoRenew Boolean @default(false)
  amount    Decimal            @db.Decimal(10, 2)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("subscriptions")
}

// * Table of Members
model Member {
  id String @id @default(uuid())

  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  firstName        String
  lastName         String
  gender           Gender
  birthDate        DateTime
  userName         String       @unique
  email            String
  password         String?
  phoneNumber      String
  photo            String       @default("default-member-image.jpg")
  address          String
  emergencyContact String
  userType         UserType     @default(USER)
  status           MemberStatus @default(ACTIVE)

  memberships   Membership[]
  payments      Payment[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("members")
}

// * Table of Membership Plan
model Membership {
  id String @id @default(uuid())

  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  membershipPlanId String
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  membershipPlanDurationId String
  membershipPlanDuration   MembershipPlanDuration @relation(fields: [membershipPlanDurationId], references: [id])

  status    MembershipStatus @default(ACTIVE)
  startDate DateTime         @default(now())
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("memberships")
}

// * Table of Membership Plan
model MembershipPlan {
  id String @id @default(uuid())

  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  planName    String
  description String?

  membershipPlanDurations MembershipPlanDuration[]
  memberships             Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("membershipPlans")
}

// * Table of Membership plan Duration
model MembershipPlanDuration {
  id String @id @default(uuid())

  durationDays Int
  price        Decimal @db.Decimal(10, 2)

  membershipPlanId String
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)

  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("membershipPlanDurations")
}

// * Table of Membership Plain
model Payment {
  id String @id @default(uuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  adminId String
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  amount    Decimal       @db.Decimal(10, 2)
  paidAt    DateTime
  dueDate   DateTime
  status    PaymentStatus @default(UNPAID)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("payments")
}

// * Table of Membership Plain
model Notification {
  id String @id @default(uuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  type      NotificationType
  message   String
  sentAt    DateTime         @default(now())
  delivered Boolean          @default(false)

  @@map("notifications")
}
