// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// * this enum had type of user 
enum UserType {
  ADMIN
  USER
}

// * this enum had Account Status
enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING
  BANNED
}

// * this enum had Subscription Status
enum SubscriptionStatus {
  FREE
  ACTIVE
  EXPIRED
  CANCELLED
}

// * this enum had Plan Type
enum PlanType {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// * this enum had Memeber Status
enum MemberStatus {
  ACTIVE
  EXPIRED
  FROZEN
  CANCELLED
}

// * this enum had Membership Duration
enum MembershipDuration {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

// * this enum had Payment Status
enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
  OVERDUE
}

// * this enum had Notification Type
enum NotificationType {
  PAYMENT_REMINDER
  MEMBERSHIP_EXPIRATION
  CUSTOM
}

// * this enum had Gender of Memeber
enum MemberGender {
  MALE
  FEMALE
}

// * Table of users
model User {
  id                String           @id @default(uuid())
  firstName         String
  lastName          String
  userName          String           @unique
  email             String           @unique
  password          String
  phoneNumber       String           @unique
  companyName       String
  userType          UserType         @default(USER)
  subscription      Subscription? // ! check this
  profileImage      String           @default("default-image.jpg")
  isAccountVerified Boolean          @default(false)
  accountStatus     AccountStatus    @default(INACTIVE)
  termsAccepted     Boolean
  members           Member[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  membershipPlans   MembershipPlan[]

  @@map("users")
}

// * Table of Subscription
model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id])
  planType  PlanType           @default(FREE)
  status    SubscriptionStatus @default(FREE)
  startedAt DateTime           @default(now())
  expiresAt DateTime
  autoRenew Boolean            @default(false)
  amount    Decimal            @db.Decimal(10, 2)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("subscriptions")
}

// * Table of Members
model Member {
  id               String          @id @default(uuid())
  ownerId          String
  owner            User            @relation(fields: [ownerId], references: [id])
  firstName        String
  lastName         String
  phoneNumber      String
  email            String
  photo            String?
  gender           MemberGender
  birthDate        DateTime
  address          String
  emergencyContact String
  status           MemberStatus
  membershipId     String
  membership       MembershipPlan? @relation(fields: [membershipId], references: [id])
  startDate        DateTime        @default(now())
  endDate          DateTime
  payments         Payment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  notifications    Notification[]

  @@map("members")
}

// * Table of Membership Plain
model MembershipPlan {
  id String @id @default(uuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  name String

  duration MembershipDuration

  price Decimal @db.Decimal(10, 2)

  description String?

  members Member[]

  createdAt DateTime @default(now())

  @@map("membershipPlans")
}

// * Table of Membership Plain
model Payment {
  id String @id @default(uuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  amount Decimal @db.Decimal(10, 2)

  paidAmount Decimal @db.Decimal(10, 2)

  dueDate DateTime

  paidAt DateTime?

  status PaymentStatus

  note String?

  createdAt DateTime @default(now())

  @@map("payments")
}

// * Table of Membership Plain
model Notification {
  id String @id @default(uuid())

  memberId String
  member   Member @relation(fields: [memberId], references: [id])

  type NotificationType

  message String

  sentAt DateTime @default(now())

  delivered Boolean @default(false)

  @@map("notifications")
}
