// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// * this enum had Gender of Member
enum Gender {
  MALE
  FEMALE
}

// * this enum had role of user
enum Role {
  OWNER
  ADMIN
  STAFF
  MEMBER
}

// * this enum had Account Status
enum UserAccountStatus {
  ACTIVE
  INACTIVE
  PENDING
  BANNED
}

// * this enum had Subscription Status
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// * this enum had Member Status
enum MemberAccountStatus {
  ACTIVE
  FROZEN
  BANNED
}

// * this enum had Member Status
enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// * this enum had Payment Status
enum PaymentStatus {
  PAID
  UNPAID
  OVERDUE
}

// * this enum had Notification Type
enum NotificationType {
  PAYMENT_REMINDER
  MEMBERSHIP_EXPIRATION
  SUBSCRIPTION_EXPIRATION
  CUSTOM
}

// * this enum had User Action Type
enum ActionTokenType {
  EMAIL_VERIFICATION
  RESET_PASSWORD
  SET_PASSWORD
}

// * Table of users
model User {
  id                   String            @id @default(uuid())
  firstName            String            @map("first_name")
  lastName             String            @map("last_name")
  gender               Gender
  birthDate            DateTime          @map("birth_date")
  userName             String            @unique @map("user_name")
  email                String            @unique
  password             String
  phoneNumber          String            @unique @map("phone_number")
  companyName          String            @map("company_name")
  role                 Role              @default(ADMIN)
  profileImageUrl      String            @default("default-image.jpg") @map("profile_image_url")
  profileImagePublicId String?           @map("profile_image_public_id")
  isAccountVerified    Boolean           @default(false) @map("is_account_verified")
  accountStatus        UserAccountStatus @default(INACTIVE) @map("account_status")
  termsAccepted        Boolean           @map("terms_accepted")

  subscription      Subscription[]
  members           Member[]
  memberships       Membership[]
  membershipPlans   MembershipPlan[]
  payments          Payment[]
  userRefreshTokens UserRefreshToken[]
  userActionTokens  UserActionToken[]
  notifications     AdminNotification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  staffs    Staff[]

  @@index([firstName, lastName])
  @@index([role])
  @@map("users")
}

// * Table of Plan
model Plan {
  id String @id @default(uuid())

  planName String @unique @map("plan_name") // BASIC, PRO, ENTERPRISE

  maxMembers  Int     @map("max_members") // 100
  description String?

  isActive Boolean @default(true) @map("is_active")

  durations     PlanDuration[]
  subscriptions Subscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

// * Table of Plan Duration
model PlanDuration {
  id String @id @default(uuid())

  durationDays Int     @map("duration_days")
  price        Decimal @db.Decimal(10, 2)

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id])

  subscriptions Subscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plan_durations")
}

// * Table of Subscription
model Subscription {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  planId String @map("plan_id")
  plan   Plan   @relation(fields: [planId], references: [id])

  planDurationId String       @map("plan_duration_id")
  planDuration   PlanDuration @relation(fields: [planDurationId], references: [id])

  subscriptionStatus SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  startedAt          DateTime           @default(now()) @map("started_at")
  expiresAt          DateTime           @map("expires_at")
  // autoRenew Boolean @default(false)
  amount             Decimal            @db.Decimal(10, 2)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([userId])
  @@index([subscriptionStatus])
  @@index([subscriptionStatus, expiresAt])
  @@index([userId, subscriptionStatus])
  @@index([planId, subscriptionStatus])
  @@map("subscriptions")
}

// * Table of staffs
model Staff {
  id          String   @id @default(uuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  gender      Gender
  birthDate   DateTime @map("birth_date")
  userName    String   @unique @map("user_name")
  email       String   @unique
  password    String?
  phoneNumber String   @unique @map("phone_number")
  companyName String   @map("company_name")

  adminId String @map("admin_id")
  admin   User   @relation(fields: [adminId], references: [id])

  role                 Role              @default(STAFF)
  profileImageUrl      String            @default("default-image.jpg") @map("profile_image_url")
  profileImagePublicId String?           @map("profile_image_public_id")
  accountStatus        UserAccountStatus @default(INACTIVE) @map("account_status")

  members            Member[]
  memberships        Membership[]
  // membershipPlans   MembershipPlan[]
  payments           Payment[]
  staffNotifications StaffNotification[]
  staffRefreshTokens StaffRefreshToken[]
  staffActionTokens  StaffActionToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([firstName, lastName])
  @@index([role])
  @@map("staffs")
}

// * Table of Members
model Member {
  id String @id @default(uuid())

  adminId String @map("admin_id")
  admin   User   @relation(fields: [adminId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  firstName            String              @map("first_name")
  lastName             String              @map("last_name")
  gender               Gender
  birthDate            DateTime            @map("birth_date")
  userName             String              @unique @map("user_name")
  email                String
  password             String?
  phoneNumber          String              @map("phone_number")
  profileImageUrl      String              @default("default-member-image.jpg") @map("profile_image_url")
  profileImagePublicId String?             @map("profile_image_public_id")
  address              String
  emergencyContact     String              @map("emergency_contact")
  role                 Role                @default(MEMBER)
  accountStatus        MemberAccountStatus @default(ACTIVE) @map("account_status")

  memberships         Membership[]
  payments            Payment[]
  notifications       MemberNotification[]
  memberRefreshTokens MemberRefreshToken[]
  memberActionTokens  MemberActionToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([adminId])
  @@index([adminId, firstName, lastName])
  @@index([adminId, email, phoneNumber])
  @@index([staffId])
  @@index([staffId, firstName, lastName])
  @@index([staffId, email, phoneNumber])
  @@map("members")
}

// * Table of Membership Plan
model Membership {
  id String @id @default(uuid())

  adminId String @map("admin_id")
  admin   User   @relation(fields: [adminId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id])

  membershipPlanId String         @map("membership_plan_id")
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  membershipPlanDurationId String                 @map("membership_plan_duration_id")
  membershipPlanDuration   MembershipPlanDuration @relation(fields: [membershipPlanDurationId], references: [id])

  membershipStatus MembershipStatus @default(ACTIVE) @map("membership_status")
  startDate        DateTime         @default(now()) @map("start_date")
  expiresAt        DateTime         @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([adminId, memberId])
  @@index([membershipStatus])
  @@index([membershipStatus, expiresAt])
  @@index([adminId, membershipPlanId, membershipStatus])
  @@index([memberId, membershipStatus])
  @@map("memberships")
}

// * Table of Membership Plan
model MembershipPlan {
  id String @id @default(uuid())

  adminId String @map("admin_id")
  admin   User   @relation(fields: [adminId], references: [id])

  planName    String  @map("plan_name")
  description String?
  isActive    Boolean @default(true) @map("is_active")

  membershipPlanDurations MembershipPlanDuration[]
  memberships             Membership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([adminId])
  @@index([adminId, planName])
  @@map("membership_plans")
}

// * Table of Membership plan Duration
model MembershipPlanDuration {
  id String @id @default(uuid())

  durationDays Int     @map("duration_days")
  price        Decimal @db.Decimal(10, 2)

  membershipPlanId String         @map("membership_plan_id")
  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id])

  memberships Membership[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([membershipPlanId])
  @@map("membership_plan_durations")
}

// * Table of Membership Plan
model Payment {
  id String @id @default(uuid())

  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id])

  adminId String @map("admin_id")
  admin   User   @relation(fields: [adminId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  amount        Decimal       @db.Decimal(10, 2)
  paidAt        DateTime      @map("paid_at")
  dueDate       DateTime      @map("due_date")
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([adminId, memberId])
  @@index([memberId])
  @@index([paymentStatus])
  @@index([paymentStatus, dueDate])
  @@map("payments")
}

// * Table of Notifications of Admin
model AdminNotification {
  id String @id @default(uuid())

  adminId String @map("admin_id")
  admin   User   @relation(fields: [adminId], references: [id])

  notificationType NotificationType @map("notification_type")
  title            String
  message          String

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@map("admin_notifications")
}

// * Table of Notifications of Staff
model StaffNotification {
  id String @id @default(uuid())

  staffId String @map("staff_id")
  staff   Staff  @relation(fields: [staffId], references: [id])

  notificationType NotificationType @map("notification_type")
  title            String
  message          String

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([staffId])
  @@map("staff_notifications")
}

// * Table of Notifications of Admin
model MemberNotification {
  id String @id @default(uuid())

  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id])

  notificationType NotificationType @map("notification_type")
  title            String
  message          String

  isRead Boolean @default(false) @map("is_read")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([memberId])
  @@map("member_notifications")
}

// * Table of User Refresh Token
model UserRefreshToken {
  id String @id @default(uuid())

  jti  String @unique
  hash String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  ip        String?
  userAgent String? @map("user_agent")
  device    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_refresh_tokens")
}

// * Table of Staff Refresh Token
model StaffRefreshToken {
  id String @id @default(uuid())

  jti  String @unique
  hash String

  staffId String @map("staff_id")
  staff   Staff  @relation(fields: [staffId], references: [id])

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  ip        String?
  userAgent String? @map("user_agent")
  device    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([staffId])
  @@map("staff_refresh_tokens")
}

// * Table of Member Refresh Token
model MemberRefreshToken {
  id String @id @default(uuid())

  jti  String @unique
  hash String

  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id])

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  ip        String?
  userAgent String? @map("user_agent")
  device    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@map("member_refresh_tokens")
}

// * Table of User Action Token
model UserActionToken {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  tokenHash String          @unique @map("token_hash")
  type      ActionTokenType
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_action_tokens")
}

// * Table of Staff Action Token
model StaffActionToken {
  id String @id @default(uuid())

  StaffId String @map("staff_id")
  staff   Staff  @relation(fields: [StaffId], references: [id])

  tokenHash String          @unique @map("token_hash")
  type      ActionTokenType
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([StaffId])
  @@map("staff_action_tokens")
}

// * Table of Member Action Token
model MemberActionToken {
  id String @id @default(uuid())

  memberId String @map("member_id")
  member   Member @relation(fields: [memberId], references: [id])

  tokenHash String          @unique @map("token_hash")
  type      ActionTokenType
  expiresAt DateTime        @map("expires_at")
  usedAt    DateTime?       @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId])
  @@map("member_action_tokens")
}
