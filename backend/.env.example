# =========================
# Application
# =========================
NODE_ENV="development"
PORT="3000"
APP_NAME="Sportium"
FRONTEND_URL="http://localhost:3001"


# =========================
# Database
# =========================
DATABASE_URL="postgresql://<user>:<password>@<hostname>:5432/<db_name>?schema=public"
POSTGRES_USER="postgres_user"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="testing_db"


# =========================
# JWT - OWNER ACCESS TOKEN
# =========================
JWT_OWNER_ACCESS_SECRET="your_secure_jwt_owner_access_secret_key"
JWT_OWNER_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - OWNER REFRESH TOKEN
# =========================
JWT_OWNER_REFRESH_SECRET="your_secure_jwt_owner_refresh_secret_key"
JWT_OWNER_REFRESH_EXPIRES_IN="30d"


# =========================
# JWT - ADMIN ACCESS TOKEN
# =========================
JWT_ADMIN_ACCESS_SECRET="your_secure_jwt_admin_access_secret_key"
JWT_ADMIN_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - ADMIN REFRESH TOKEN
# =========================
JWT_ADMIN_REFRESH_SECRET="your_secure_jwt_admin_refresh_secret_key"
JWT_ADMIN_REFRESH_EXPIRES_IN="30d"


# =========================
# JWT - STAFF ACCESS TOKEN
# =========================
JWT_STAFF_ACCESS_SECRET="your_secure_jwt_staff_access_secret_key"
JWT_STAFF_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - STAFF REFRESH TOKEN
# =========================
JWT_STAFF_REFRESH_SECRET="your_secure_jwt_staff_refresh_secret_key"
JWT_STAFF_REFRESH_EXPIRES_IN="30d"


# =========================
# JWT - MEMBER ACCESS TOKEN
# =========================
JWT_MEMBER_ACCESS_SECRET="your_secure_jwt_member_access_secret_key"
JWT_MEMBER_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - MEMBER REFRESH TOKEN
# =========================
JWT_MEMBER_REFRESH_SECRET="your_secure_jwt_member_refresh_secret_key"
JWT_MEMBER_REFRESH_EXPIRES_IN="30d"


# =========================
# EMAIL VERIFICATION TOKEN
# =========================
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="1h"


# =========================
# RESET PASSWORD TOKEN
# =========================
RESET_PASSWORD_TOKEN_EXPIRES_IN="15m"


# =========================
# SET PASSWORD TOKEN
# =========================
SET_PASSWORD_TOKEN_EXPIRES_IN="1d"


# =========================
# EMAIL CHANGE TOKEN
# =========================
EMAIL_CHANGE_TOKEN_EXPIRES_IN="15m"


# =========================
# Cookie
# =========================
COOKIE_SECRET="your_secure_cookie_secret_key"


# =========================
#  Resend Email
# =========================
RESEND_API_KEY="key_for_development"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your_email@gmail.com"
MAIL_PASSWORD="your_email_password"
MAIL_FROM="onboarding@resend.dev"
SUPPORT_EMAIL="support@example.com"


# =========================
#  Node Mailer Email
# =========================
NODE_MAIL_USER="test@gmail.com"
NODE_MAIL_PASSWORD="your-16-character-app-password"
NODE_MAIL_FROM="Sportium <test@gmail.com>"
NODE_SUPPORT_EMAIL="support@example.com"


# =========================
# CLOUDINARY
# =========================
CLOUDINARY_CLOUD_NAME="--"
CLOUDINARY_API_KEY="--"
CLOUDINARY_API_SECRET="--"


# =========================
# REDIS
# =========================
REDIS_URL="redis://localhost:6379"


# =========================
# AI API
# =========================
AI_API_URL="http://localhost:8000/internal/sentiment"
INTERNAL_API_KEY="api_key"


# =========================
# BLOCKCHAIN API
# =========================
BLOCKCHAIN_REWARD_API_URL="http://blockchain:3000/blockchain/rewardClient"
REWARD_INTERNAL_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


# =========================
# OWNER SEED ACCOUNT
# =========================
OWNER_FIRST_NAME="owner_user"
OWNER_LAST_NAME="owner_user"
OWNER_BIRTH_DATE="YYYYY-MM-DD"
OWNER_USERNAME="owner"
OWNER_EMAIL="owner.test@gmail.com"
OWNER_PASSWORD="Test@1337"
OWNER_PHONE_NUMBER="+212601020304"
OWNER_COMPANY_NAME="Sportium"
