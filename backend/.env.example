# =========================
# Application
# =========================
NODE_ENV="development"
PORT="3000"
APP_NAME="Sportium"
FRONTEND_URL="https://localhost:8443"

# =========================
# JWT - OWNER ACCESS TOKEN
# =========================
# @generate base64url
JWT_OWNER_ACCESS_SECRET=
JWT_OWNER_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - OWNER REFRESH TOKEN
# =========================
# @generate base64url
JWT_OWNER_REFRESH_SECRET=
JWT_OWNER_REFRESH_EXPIRES_IN="30d"

# =========================
# JWT - ADMIN ACCESS TOKEN
# (the secret is shared with the AI, see devops/.env)
# =========================
JWT_ADMIN_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - ADMIN REFRESH TOKEN
# =========================
# @generate base64url
JWT_ADMIN_REFRESH_SECRET=
JWT_ADMIN_REFRESH_EXPIRES_IN="30d"

# =========================
# JWT - STAFF ACCESS TOKEN
# (the secret is shared with the AI, see devops/.env)
# =========================
JWT_STAFF_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - STAFF REFRESH TOKEN
# =========================
# @generate base64url
JWT_STAFF_REFRESH_SECRET=
JWT_STAFF_REFRESH_EXPIRES_IN="30d"

# =========================
# JWT - MEMBER ACCESS TOKEN
# (the secret is shared with the AI, see devops/.env)
# =========================
JWT_MEMBER_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - MEMBER REFRESH TOKEN
# =========================
# @generate base64url
JWT_MEMBER_REFRESH_SECRET=
JWT_MEMBER_REFRESH_EXPIRES_IN="30d"

# =========================
# EMAIL VERIFICATION TOKEN
# =========================
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="1h"

# =========================
# RESET PASSWORD TOKEN
# =========================
RESET_PASSWORD_TOKEN_EXPIRES_IN="15m"

# =========================
# SET PASSWORD TOKEN
# =========================
SET_PASSWORD_TOKEN_EXPIRES_IN="1d"

# =========================
# EMAIL CHANGE TOKEN
# =========================
EMAIL_CHANGE_TOKEN_EXPIRES_IN="15m"

# =========================
# Resend Email ( this section is for production only)
# =========================
RESEND_API_KEY="key_for_development"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your_email@gmail.com"
MAIL_PASSWORD="your_email_password"
MAIL_FROM="onboarding@resend.dev"
SUPPORT_EMAIL="support@example.com"

# =========================
# Node Mailer Email (optional: emails are not sent until set)
# =========================
# @optional
NODE_MAIL_USER=
# @optional
NODE_MAIL_PASSWORD=
# @optional
NODE_MAIL_FROM=
# @optional
NODE_SUPPORT_EMAIL=

# =========================
# CLOUDINARY (optional: image upload is disabled until set)
# =========================
# @optional
CLOUDINARY_CLOUD_NAME=
# @optional
CLOUDINARY_API_KEY=
# @optional
CLOUDINARY_API_SECRET=

# =========================
# AI API
# =========================
AI_API_URL="http://ai:8000/internal/sentiment"

# =========================
# BLOCKCHAIN API
# =========================
BLOCKCHAIN_REWARD_API_URL="http://blockchain:3000/blockchain/rewardClient"

# =========================
# OWNER SEED ACCOUNT
# =========================
OWNER_FIRST_NAME="owner_user"
OWNER_LAST_NAME="owner_user"
OWNER_BIRTH_DATE="1990-01-01"
OWNER_USERNAME="owner"
OWNER_EMAIL="owner@sportium.local"
# @required
OWNER_PASSWORD=
OWNER_PHONE_NUMBER="+212601020304"
OWNER_COMPANY_NAME="Sportium"
