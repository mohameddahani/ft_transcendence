
# =========================
# Application
# =========================
NODE_ENV="development"
PORT="4000"
APP_NAME="ft_transcendence"
FRONTEND_URL="http://localhost:3000"

# =========================
# Database
# =========================
DATABASE_URL="postgresql://example_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/example_db?schema=public"
POSTGRES_USER="example_user"
POSTGRES_PASSWORD="REPLACE_WITH_DB_PASSWORD"
POSTGRES_DB="example_db"

# =========================
# JWT - OWNER ACCESS TOKEN
# =========================
JWT_OWNER_ACCESS_SECRET="REPLACE_WITH_OWNER_ACCESS_SECRET"
JWT_OWNER_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - OWNER REFRESH TOKEN
# =========================
JWT_OWNER_REFRESH_SECRET="REPLACE_WITH_OWNER_REFRESH_SECRET"
JWT_OWNER_REFRESH_EXPIRES_IN="30d"

# =========================
# JWT - ADMIN ACCESS TOKEN
# =========================
JWT_ADMIN_ACCESS_SECRET="REPLACE_WITH_ADMIN_ACCESS_SECRET"
JWT_ADMIN_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - ADMIN REFRESH TOKEN
# =========================
JWT_ADMIN_REFRESH_SECRET="REPLACE_WITH_ADMIN_REFRESH_SECRET"
JWT_ADMIN_REFRESH_EXPIRES_IN="30d"

# =========================
# JWT - STAFF ACCESS TOKEN
# =========================
JWT_STAFF_ACCESS_SECRET="REPLACE_WITH_STAFF_ACCESS_SECRET"
JWT_STAFF_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - STAFF REFRESH TOKEN
# =========================
JWT_STAFF_REFRESH_SECRET="REPLACE_WITH_STAFF_REFRESH_SECRET"
JWT_STAFF_REFRESH_EXPIRES_IN="30d"

# =========================
# JWT - MEMBER ACCESS TOKEN
# =========================
JWT_MEMBER_ACCESS_SECRET="REPLACE_WITH_MEMBER_ACCESS_SECRET"
JWT_MEMBER_ACCESS_EXPIRES_IN="15m"

# =========================
# JWT - MEMBER REFRESH TOKEN
# =========================
JWT_MEMBER_REFRESH_SECRET="REPLACE_WITH_MEMBER_REFRESH_SECRET"
JWT_MEMBER_REFRESH_EXPIRES_IN="30d"

# =========================
# EMAIL VERIFICATION TOKEN
# =========================
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="1h"

# =========================
# RESET PASSWORD TOKEN
# =========================
RESET_PASSWORD_TOKEN_EXPIRES_IN="15m"

# =========================
# SET PASSWORD TOKEN
# =========================
SET_PASSWORD_TOKEN_EXPIRES_IN="1d"

# =========================
# EMAIL CHANGE TOKEN
# =========================
EMAIL_CHANGE_TOKEN_EXPIRES_IN="15m"

# =========================
# Cookie
# =========================
COOKIE_SECRET="REPLACE_WITH_COOKIE_SECRET"

# =========================
# Resend Email
# =========================
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="sender@example.com"
MAIL_PASSWORD="REPLACE_WITH_MAIL_PASSWORD"
MAIL_FROM="no-reply@example.com"
SUPPORT_EMAIL="support@example.com"

# =========================
# Node Mailer Email
# =========================
NODE_MAIL_USER="sender@example.com"
NODE_MAIL_PASSWORD="REPLACE_WITH_NODE_MAIL_PASSWORD"
NODE_MAIL_FROM="Example App <sender@example.com>"
NODE_SUPPORT_EMAIL="support@example.com"

# =========================
# CLOUDINARY
# =========================
CLOUDINARY_CLOUD_NAME="REPLACE_WITH_CLOUD_NAME"
CLOUDINARY_API_KEY="REPLACE_WITH_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="REPLACE_WITH_CLOUDINARY_API_SECRET"

# =========================
# REDIS
# =========================
REDIS_URL="redis://localhost:6379"

# =========================
# AI API
# =========================
AI_API_URL="http://localhost:8000/internal/sentiment"
INTERNAL_API_KEY="REPLACE_WITH_INTERNAL_API_KEY"

# =========================
# BLOCKCHAIN API
# =========================
BLOCKCHAIN_REWARD_API_URL="https://blockchain-api.example.com/blockchain/rewardClient"
REWARD_INTERNAL_SECRET="REPLACE_WITH_REWARD_INTERNAL_SECRET"

# =========================
# OWNER SEED ACCOUNT
# =========================
OWNER_FIRST_NAME="Example"
OWNER_LAST_NAME="Owner"
OWNER_BIRTH_DATE="2000-01-01"
OWNER_USERNAME="example_owner"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="REPLACE_WITH_STRONG_OWNER_PASSWORD"
OWNER_PHONE_NUMBER="+212600000000"
OWNER_COMPANY_NAME="Example Sports Club"
