# Postgres (local dev)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ft_transcendence
POSTGRES_PORT=5432

# the AI service connects with the read-only role (seeder/roles/ai_readonly.sql)
AI_DATABASE_URL=postgresql://ai_readonly:change_me@postgres:5432/ft_transcendence

# same values as backend/.env
JWT_ADMIN_ACCESS_SECRET=change_me
JWT_STAFF_ACCESS_SECRET=change_me
JWT_MEMBER_ACCESS_SECRET=change_me

# shared with the backend, protects /internal/*
INTERNAL_API_KEY=change_me

GEMINI_API_KEY=change_me
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

FRONTEND_URL=http://localhost:3000
