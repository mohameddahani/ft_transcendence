# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# For local development these must match the DATABASE_URL in backend/.env,
# otherwise Prisma migrates one database and the AI service reads another.

POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ft_transcendence
POSTGRES_PORT=5432
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=replace_me_with_a_32_byte_urlsafe_token
# --- AI service database access (task 0.2) ---
# The AI service connects as `ai_readonly`, NOT as `admin`. That role can SELECT the
# read-model columns in AI_SPECS 2.1 and nothing else -- see seeder/roles/ai_readonly.sql.
# Host is the compose service name; when running uvicorn from .venv on the host instead,
# override with 127.0.0.1.
AI_DB_USER=ai_readonly
AI_DB_PASSWORD=change_me
AI_DATABASE_URL=postgresql+asyncpg://ai_readonly:change_me@postgres:5432/ft_transcendence

# --- JWT verification (task 0.5) ---
# Copy the two ACCESS secrets verbatim from backend/.env — they must match Dahani's
# byte for byte or every token is rejected with a 401. Do NOT copy the OWNER or the
# REFRESH secrets: not holding them is how platform tokens are kept out.
# The service refuses to boot if these two are set to the same value.
JWT_ADMIN_ACCESS_SECRET=change_me_min_32_chars_admin_access_secret
JWT_MEMBER_ACCESS_SECRET=change_me_min_32_chars_member_access_secret

# --- AI service state + rate limiting (task 0.7) ---
# SQLite on a named volume, NOT in Dahani's Postgres: this is our state, and his
# database is read-only to us. The directory is created in the Dockerfile and owned
# by appuser, so the path must stay under /data.
SQLITE_PATH=/data/ai_state.db
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_DOCS_PER_MIN=10
# The rolling window the two limits are measured over. Kept configurable so a test
# can use a two-second window instead of sleeping a minute.
RATE_LIMIT_WINDOW_SECONDS=60

# --- Gemini + agent (tasks 2.1, 2.2) ---
GEMINI_API_KEY=replace_with_gemini_api_key
# Confirmed against the API, not guessed: models.get resolves it and it supports
# function calling. gemini-2.5-flash is the chat model; embeddings come later.
GEMINI_CHAT_MODEL=gemini-2.5-flash
# gemini-2.5-flash reasons before answering unless told not to, and measured on this
# tool registry that made it *worse*: thinking on, it burned ~190 reasoning tokens
# and returned no tool call for "who hasn't checked in for three weeks and expires
# soon?"; thinking off, it called both tools correctly in half the time. 0 disables
# it, -1 hands the decision back to the model.
GEMINI_THINKING_BUDGET=0
# A ceiling on one Gemini call, not on one answer -- an answer may take several.
GEMINI_TIMEOUT_SECONDS=30
# Rounds of tool execution one question may spend before the agent has to answer
# with what it already has.
AGENT_MAX_TOOL_ROUNDS=5
# Longest question /ai/chat will accept. Enforced here as well as in the frontend --
# the browser is not the only thing that can post to this endpoint.
MAX_MESSAGE_CHARS=2000
# Messages of a conversation re-sent to the model each turn (task 2.4).
AGENT_HISTORY_MESSAGES=24
# How long a conversation survives without being used.
THREAD_TTL_DAYS=90
