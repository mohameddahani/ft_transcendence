# =========================
# Domain
# =========================
DOMAIN="localhost"


# =========================
# Database
# =========================
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<db_name>"
POSTGRES_USER="postgres_user"
# @generate hex
POSTGRES_PASSWORD=
POSTGRES_DB="testing_db"

AI_DB_USER="ai_db_user"
# @generate hex
AI_DB_USER_PASSWORD=

REWARDS_DB_USER="rewarder_user"
# @generate hex
REWARDS_DB_PASSWORD=


# =========================
# Redis
# =========================
# @generate hex
REDIS_PASSWORD=

# =========================
# Grafana
# =========================
GRAFANA_USER="grafana_user"
GRAFANA_URL="https://localhost/grafana"
# @generate hex
GRAFANA_PASSWORD=
# @generate base64url
GRAFANA_SECRET_KEY=


# =========================
# Discord Webhook
# =========================
# @required
DISCORD_WEBHOOK_URL=


# =========================
# Backup Scheduling
# =========================
BACKUP_SCHEDULE="*/5 * * * *"   # every 5 minutes


# ============================
# NextJs Build Time Variables
# ============================
NEXT_PUBLIC_API_URL="/owner-portal"

# @required
NEXT_PUBLIC_GYMTOKEN_ADDRESS=
# @required
NEXT_PUBLIC_FORWARDER_ADDRESS=


# ============================
# Private Internal API Keys
# ============================
# @generate hex
INTERNAL_API_KEY=
# @generate hex
REWARD_INTERNAL_SECRET=


# =========================
# JWT Token Secrets
# =========================
# @generate base64url
JWT_ADMIN_ACCESS_SECRET=
# @generate base64url
JWT_STAFF_ACCESS_SECRET=
# @generate base64url
JWT_MEMBER_ACCESS_SECRET=
