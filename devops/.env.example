# =========================
# Domain
# =========================
DOMAIN=gymFlow.com

# =========================
# Database
# =========================
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<db_name>"
POSTGRES_USER="postgres_user"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="testing_db"

AI_DB_USER="ai_db_user"
AI_DB_USER_PASSWORD="change_me"

# =========================
# Redis
# =========================
REDIS_PASSWORD="change_me"

# =========================
# Grafana
# =========================
GRAFANA_USER="grafana_user"
GRAFANA_PASSWORD="change_me"
GRAFANA_URL="grafana_accessed_at"
GRAFANA_SECRET_KEY="your_secure_grafana_secret_key"

# =========================
# Discord Webhook
# =========================
DISCORD_WEBHOOK_URL="discord_webhook_url"

# =========================
# Backup Scheduling
# =========================
BACKUP_SCHEDULE=*/5 * * * * # ex: every 5 minutes

# ============================
# NextJs Build Time Variables
# ============================
NEXT_PUBLIC_API_URL=/<owner-platform-path>

NEXT_PUBLIC_GYMTOKEN_ADDRESS=<gym_token_address>
NEXT_PUBLIC_FORWARDER_ADDRESS=<forwarder_token_address
NEXT_PUBLIC_API_URL_RELAYER=http://localhost:3000/blockchain/relayer
NEXT_PUBLIC_FETCH_PLANS_URL=/api/members/membership-plans
NEXT_PUBLIC_UPDATE_WALLET_ADDRESS_MEMBER=/api/users/members/edit-profile
NEXT_PUBLIC_UPDATE_WALLET_ADDRESS_ADMIN=/api/users/admins/edit-profile