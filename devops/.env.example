# =========================
# Domain & Ports
# =========================
DOMAIN="localhost"
HTTP_PORT="8080"
HTTPS_PORT="8443"

# =========================
# Database Settings
# =========================
POSTGRES_USER="postgres_user"
# @generate hex
POSTGRES_PASSWORD=
POSTGRES_DB="testing_db"

AI_DB_USER="ai_db_user"
# @generate hex
AI_DB_USER_PASSWORD=

AI_WRITER_USER="ai_writer"
# @generate hex
AI_WRITER_PASSWORD=

REWARDS_DB_USER="rewarder_user"
# @generate hex
REWARDS_DB_PASSWORD=

# =========================
# Redis
# =========================
# @generate hex
REDIS_PASSWORD=

# =========================
# Grafana
# =========================
GRAFANA_USER="grafana_user"
GRAFANA_URL="https://localhost/grafana"
# @generate hex
GRAFANA_PASSWORD=
# @generate hex
GRAFANA_SECRET_KEY=

# =========================
# Discord Webhook (alerts need it, Alertmanager will not start without it)
# =========================
# @required
DISCORD_WEBHOOK_URL=

# =========================
# Backup Scheduling (cron expression, default: every day at 02:00)
# =========================
BACKUP_SCHEDULE="0 2 * * *"

# ============================
# NextJs Build Time Variables
# ============================
NEXT_PUBLIC_API_URL="/owner-portal"

# @required
NEXT_PUBLIC_GYMTOKEN_ADDRESS=
# @required
NEXT_PUBLIC_FORWARDER_ADDRESS=

# ============================
# Private Internal API Keys (shared between services)
# ============================
# @generate hex
INTERNAL_API_KEY=
# @generate hex
REWARD_INTERNAL_SECRET=

# =========================
# JWT Access Token Secrets (shared by the backend and the AI services)
# =========================
# @generate base64url
JWT_ADMIN_ACCESS_SECRET=
# @generate base64url
JWT_STAFF_ACCESS_SECRET=
# @generate base64url
JWT_MEMBER_ACCESS_SECRET=
